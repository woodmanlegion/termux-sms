#!/data/data/com.termux/files/usr/bin/bash
# mms-calibrate - Detect SIM phone number and screen coords, write ~/.config/termux-sms/config
# Usage: mms-calibrate

set -euo pipefail

CONFIG_FILE="$HOME/.config/termux-sms/config"

# ── SIM phone number detection ──────────────────────────────────────────────
# Uses iphonesubinfo service call 16 (line1 number), requires root.
# Returns empty string if unavailable.
detect_sim_number() {
    local raw
    raw=$(su -c "service call iphonesubinfo 16 i32 0 i32 1" 2>/dev/null) || return
    # Extract all single-quoted sections, strip dots and spaces, keep digits only
    echo "$raw" | grep -oP "'[^']+'" | tr -d "'. " | tr -cd '0-9' | grep -oE '[0-9]{10,}' | head -1
}

echo "=== mms-calibrate ==="
echo ""

# ── Detect SIM number ────────────────────────────────────────────────────────
echo "Detecting SIM phone number..."
SIM_NUMBER=$(detect_sim_number)

if [[ -n "$SIM_NUMBER" ]]; then
    FROM_NUMBER="+${SIM_NUMBER}"
    echo "  Found: $FROM_NUMBER (from SIM via iphonesubinfo)"
else
    echo "  Could not read SIM number (try running as root)"
    # Fall back to existing config or prompt
    if [[ -f "$CONFIG_FILE" ]]; then
        EXISTING=$(grep -i '^FROM_NUMBER' "$CONFIG_FILE" | cut -d= -f2 | tr -d ' ' || true)
        if [[ -n "$EXISTING" ]]; then
            FROM_NUMBER="$EXISTING"
            echo "  Using existing config value: $FROM_NUMBER"
        else
            echo "  ERROR: Set FROM_NUMBER in $CONFIG_FILE manually."
            FROM_NUMBER=""
        fi
    else
        echo "  ERROR: Set FROM_NUMBER in $CONFIG_FILE manually."
        FROM_NUMBER=""
    fi
fi

# ── Detect active rmnet interface ────────────────────────────────────────────
echo ""
echo "Detecting mobile data interface..."
ACTIVE_IF=$(ifconfig 2>/dev/null | awk '/^rmnet_data/{iface=$1; sub(/:$/,"",iface)} iface && /UP/ && /RUNNING/{print iface; exit}')

if [[ -n "$ACTIVE_IF" ]]; then
    echo "  Found: $ACTIVE_IF (UP+RUNNING)"
else
    echo "  No active rmnet_data* interface found — will auto-detect at send time"
fi

# ── Detect screen size (for mms-send-auto coords) ───────────────────────────
echo ""
SCREEN=$(su -c 'wm size' 2>/dev/null | grep -oE '[0-9]+x[0-9]+' || echo "1080x2460")
WIDTH=$(echo "$SCREEN" | cut -dx -f1)
HEIGHT=$(echo "$SCREEN" | cut -dx -f2)
echo "Screen size: ${WIDTH}x${HEIGHT}"

# ── Write config ─────────────────────────────────────────────────────────────
echo ""
echo "Writing $CONFIG_FILE ..."

mkdir -p "$(dirname "$CONFIG_FILE")"
cat > "$CONFIG_FILE" <<EOF
# mms-send configuration — generated by mms-calibrate $(date +%Y-%m-%d)
FROM_NUMBER = ${FROM_NUMBER}
# INTERFACE auto-detected at send time (active rmnet_data* UP+RUNNING)
# To pin: uncomment and set INTERFACE = rmnet_data3
MMSC        = http://mmsc.mobile.att.net
PROXY_IP    = 172.26.39.1
PROXY_PORT  = 80
MAX_BYTES   = 900000
EOF

echo "  Done."
echo ""
cat "$CONFIG_FILE"
echo ""

# ── Screen coords for mms-send-auto ─────────────────────────────────────────
echo "Tap coordinates for ${WIDTH}x${HEIGHT} (mms-send-auto):"
echo "  Attachment: $((WIDTH * 5 / 6)),$((HEIGHT * 9 / 10))"
echo "  Menu item:  $((WIDTH / 2)),$((HEIGHT * 3 / 4))"
echo "  Downloads:  $((WIDTH / 5)),$((HEIGHT / 6))"
echo "  File:       $((WIDTH / 2)),$((HEIGHT / 4))"
echo "  Send:       $((WIDTH * 5 / 6)),$((HEIGHT * 9 / 10))"
echo ""
echo "Verify with: mms-http-send --show-config"
