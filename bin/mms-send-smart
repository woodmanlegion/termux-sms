#!/data/data/com.termux/files/usr/bin/bash
# mms-send-smart - Headless MMS with audio/image attachment
# Requires: root (su), Google Messages as default SMS app, screen unlocked
# Usage: mms-send-smart <phone> <file>

set -euo pipefail

PHONE="${1:-}"; FILE="${2:-}"
[[ -z "$PHONE" || -z "$FILE" ]] && { echo "Usage: mms-send-smart <phone> <file>"; exit 1; }
[[ ! -f "$FILE" ]] && { echo "Error: File not found: $FILE"; exit 1; }

FILENAME=$(basename "$FILE")
EXT="${FILENAME##*.}"

# Convert WAV to MP3 to stay within MMS size limits (~300KB vs 1-3MB)
if [[ "${EXT,,}" == "wav" ]]; then
    MP3_FILE="${FILE%.wav}.mp3"
    echo "[mms] Converting WAV to MP3..."
    /data/data/com.termux/files/usr/bin/ffmpeg -y -i "$FILE" -q:a 4 -ar 22050 "$MP3_FILE" 2>/dev/null
    FILE="$MP3_FILE"
    FILENAME=$(basename "$FILE")
    EXT="mp3"
fi

DEST="/storage/emulated/0/Download/mms_send_$(date +%s)_${FILENAME}"
UI_DUMP="/sdcard/mms_ui.xml"

# MIME type
case "${EXT,,}" in
    mp3) MIME="audio/mpeg" ;; m4a) MIME="audio/mp4" ;;
    wav) MIME="audio/x-wav" ;; ogg) MIME="audio/ogg" ;;
    jpg|jpeg) MIME="image/jpeg" ;; png) MIME="image/png" ;;
    gif) MIME="image/gif" ;; *) MIME="application/octet-stream" ;;
esac

echo "[mms] Copying to shared storage ($(du -sh "$FILE" | cut -f1))..."
cp "$FILE" "$DEST" && chmod 644 "$DEST"

echo "[mms] Registering in MediaStore..."
/data/data/com.termux/files/usr/bin/termux-media-scan "$DEST" 2>/dev/null

# Get MediaStore ID via content provider (works before DB flush to disk)
MEDIA_ID=""
for attempt in 1 2 3; do
    sleep 2
    if [[ "$MIME" == image/* ]]; then
        MS_URI="content://media/external/images/media"
    else
        MS_URI="content://media/external/audio/media"
    fi
    MEDIA_ID=$(su -c "/system/bin/content query --uri $MS_URI --projection _id --where \"_data='$DEST'\"" 2>/dev/null | grep -oE '_id=[0-9]+' | cut -d= -f2 | head -1)
    [[ -n "$MEDIA_ID" ]] && break
    echo "[mms] MediaStore not ready yet (attempt $attempt)..."
done

if [[ -z "$MEDIA_ID" ]]; then
    echo "[mms] ERROR: File not indexed in MediaStore. Aborting."
    exit 1
fi

# Determine MediaStore URI based on type
if [[ "$MIME" == image/* ]]; then
    CONTENT_URI="content://media/external/images/media/$MEDIA_ID"
else
    CONTENT_URI="content://media/external/audio/media/$MEDIA_ID"
fi
echo "[mms] Content URI: $CONTENT_URI"

# Wake screen
su -c "input keyevent KEYCODE_WAKEUP" 2>/dev/null; sleep 0.5

# Open ShareIntentActivity with file + phone number
echo "[mms] Opening Messages with attachment..."
su -c "am start -a android.intent.action.SEND \
    -t '$MIME' \
    --eu 'android.intent.extra.STREAM' '$CONTENT_URI' \
    --es 'address' '$PHONE' \
    --grant-read-uri-permission \
    -n com.google.android.apps.messaging/.ui.conversationlist.ShareIntentActivity 2>&1"

echo "[mms] Waiting for UI..."
sleep 4

# Dump UI and find Send button
su -c "uiautomator dump '$UI_DUMP'" 2>/dev/null

# Check for attachment failure
if su -c "grep -q 'Failed to add attachment' '$UI_DUMP'" 2>/dev/null; then
    echo "[mms] ERROR: Messages rejected attachment (check MIME type / permissions)"
    exit 1
fi

# Find Send button — "Send MMS" content-desc or "Compose:Draft:Send" resource-id
SEND_BOUNDS=$(python3 -c "
import xml.etree.ElementTree as ET
tree = ET.parse('$UI_DUMP')
for node in tree.iter('node'):
    rid=node.get('resource-id',''); desc=node.get('content-desc','')
    if 'Compose:Draft:Send' in rid or 'Send MMS' in desc or 'Send SMS' in desc:
        print(node.get('bounds',''))
        break
" 2>/dev/null || echo "")

if [[ -z "$SEND_BOUNDS" ]]; then
    echo "[mms] ERROR: Could not find Send button. Check UI dump at $UI_DUMP"
    exit 1
fi

# Parse [x1,y1][x2,y2] -> center
X1=$(echo "$SEND_BOUNDS" | grep -oE '\[[0-9]+,[0-9]+\]' | head -1 | tr -d '[]' | cut -d, -f1)
Y1=$(echo "$SEND_BOUNDS" | grep -oE '\[[0-9]+,[0-9]+\]' | head -1 | tr -d '[]' | cut -d, -f2)
X2=$(echo "$SEND_BOUNDS" | grep -oE '\[[0-9]+,[0-9]+\]' | tail -1 | tr -d '[]' | cut -d, -f1)
Y2=$(echo "$SEND_BOUNDS" | grep -oE '\[[0-9]+,[0-9]+\]' | tail -1 | tr -d '[]' | cut -d, -f2)
CX=$(( (X1 + X2) / 2 )); CY=$(( (Y1 + Y2) / 2 ))

echo "[mms] Tapping Send at ($CX, $CY)..."
su -c "input tap $CX $CY"
sleep 2

echo "[mms] Done. MMS sent to $PHONE"
su -c "rm -f '$UI_DUMP'" 2>/dev/null || true
