#!/usr/bin/env python3
"""
sms-send - Send SMS via termux-sms-send with config, structured output, and rate-limit preflight.

Usage:
  sms-send <phone> <message>           # send SMS
  sms-send <phone> <message> [--json]  # structured output
  sms-send --show-config               # print effective config as JSON and exit
"""

import sys, os, subprocess, json, time

# ── Configuration resolution ──────────────────────────────────────────────────
# Priority (highest first):
#   1. ~/.config/termux-sms/config  (INI-style key=value, # comments)
#   2. OPENCLAW_SMS_FROM / PHONE_NUMBER env vars
#   3. Built-in default (warns on stderr)

CONFIG_FILE = os.path.expanduser('~/.config/termux-sms/config')
_BUILTIN = {
    'from_number':          '',   # must be set in ~/.config/termux-sms/config or PHONE_NUMBER env
    'sim_slot':             '0',
    'apply_rate_limit_fix': 'true',
    'sms_send_timeout':     '30',
}

TERMUX_SMS_SEND = '/data/data/com.termux/files/usr/bin/termux-sms-send'
SU              = '/system/xbin/su'

def _load_config_file(path):
    cfg = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                if '=' in line:
                    k, _, v = line.partition('=')
                    cfg[k.strip().lower()] = v.strip()
    except FileNotFoundError:
        pass
    return cfg

def _resolve_config():
    file_cfg = _load_config_file(CONFIG_FILE)
    cfg, sources = {}, {}

    def pick(key, env_keys=(), warn_default=False):
        if key in file_cfg:
            cfg[key] = file_cfg[key]
            sources[key] = f'file:{CONFIG_FILE}'
            return
        for env_key in env_keys:
            val = os.environ.get(env_key, '').strip()
            if val:
                cfg[key] = val
                sources[key] = f'env:{env_key}'
                return
        if warn_default and key == 'from_number':
            print(f'[sms] Warning: FROM_NUMBER not set in {CONFIG_FILE}, '
                  'OPENCLAW_SMS_FROM, or PHONE_NUMBER.',
                  file=sys.stderr)
            print(f'[sms] Edit {CONFIG_FILE} and set: FROM_NUMBER = +1XXXXXXXXXX',
                  file=sys.stderr)
        cfg[key] = _BUILTIN[key]   # empty string for from_number — informational only
        sources[key] = 'default'

    pick('from_number',          ('OPENCLAW_SMS_FROM', 'PHONE_NUMBER'), warn_default=True)
    pick('sim_slot',             ('OPENCLAW_SMS_SIM_SLOT',))
    pick('apply_rate_limit_fix', ('OPENCLAW_SMS_RATE_LIMIT_FIX',))
    pick('sms_send_timeout',     ('OPENCLAW_SMS_TIMEOUT',))
    return cfg, sources

_CFG, _SOURCES = _resolve_config()

FROM_NUMBER          = _CFG['from_number']
SIM_SLOT             = int(_CFG['sim_slot'])
APPLY_RATE_LIMIT_FIX = _CFG['apply_rate_limit_fix'].lower() not in ('false', '0', 'no', 'off')
SMS_SEND_TIMEOUT     = int(_CFG['sms_send_timeout'])


# ── SMS character handling ────────────────────────────────────────────────────

# GSM 7-bit character set (basic + extended). Anything outside = Unicode mode.
_GSM7 = set(
    '@£$¥èéùìòÇ\nØø\rÅåΔ_ΦΓΛΩΠΨΣΘΞ\x1bÆæßÉ !"#¤%&\'()*+,-./'
    '0123456789:;<=>?¡ABCDEFGHIJKLMNOPQRSTUVWXYZ'
    'ÄÖÑÜ§¿abcdefghijklmnopqrstuvwxyz'
    'äöñüà'
)

def sms_encoding(text):
    """Return ('gsm7'|'unicode', parts, chars_per_part, total_chars)."""
    is_gsm7 = all(c in _GSM7 for c in text)
    n = len(text)
    if is_gsm7:
        limit_single, limit_multi = 160, 153
        enc = 'gsm7'
    else:
        limit_single, limit_multi = 70, 67
        enc = 'unicode'
    if n <= limit_single:
        return enc, 1, limit_single, n
    parts = -(-n // limit_multi)   # ceiling division
    return enc, parts, limit_multi, n


# ── Rate limit fix ────────────────────────────────────────────────────────────

SMS_RATE_SETTINGS = [
    ('sms_outgoing_check_max_count',   '99999'),
    ('sms_outgoing_check_interval_ms', '99999999'),
]

def apply_rate_limit_fix(json_mode=False):
    """Apply Android SMS rate limit bypass (idempotent, ~20ms)."""
    for key, value in SMS_RATE_SETTINGS:
        subprocess.run(
            [SU, '-c', f'settings put global {key} {value}'],
            capture_output=True, timeout=5
        )


# ── Send ──────────────────────────────────────────────────────────────────────

def send_sms(to_num, message, json_mode=False):
    if APPLY_RATE_LIMIT_FIX:
        try:
            apply_rate_limit_fix(json_mode)
        except Exception:
            pass   # non-fatal — proceed with send

    enc, parts, chars_per_part, total = sms_encoding(message)
    if not json_mode:
        part_note = f'{parts}-part' if parts > 1 else 'single'
        print(f'[sms] To:      {to_num}')
        print(f'[sms] Length:  {total} chars ({enc}, {part_note})')
        print(f'[sms] Sending via termux-sms-send...')

    cmd = [TERMUX_SMS_SEND, '-n', to_num]
    if SIM_SLOT >= 0:
        cmd += ['-s', str(SIM_SLOT)]
    cmd.append(message)

    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=SMS_SEND_TIMEOUT
        )
    except subprocess.TimeoutExpired:
        return False, 'timeout', f'termux-sms-send did not return within {SMS_SEND_TIMEOUT}s — rate-limit dialog may be blocking'
    except FileNotFoundError:
        return False, 'binary_not_found', f'termux-sms-send not found at {TERMUX_SMS_SEND}'

    stderr = result.stderr.strip()
    if result.returncode != 0:
        return False, 'send_failed', stderr or f'exit code {result.returncode}'

    return True, None, None


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) >= 2 and sys.argv[1] == '--show-config':
        out = {
            'config': {k: _CFG[k] for k in sorted(_CFG)},
            'sources': {k: _SOURCES[k] for k in sorted(_SOURCES)},
            'config_file': CONFIG_FILE,
            'config_file_exists': os.path.exists(CONFIG_FILE),
            'termux_sms_send': TERMUX_SMS_SEND,
            'termux_sms_send_exists': os.path.exists(TERMUX_SMS_SEND),
        }
        print(json.dumps(out, indent=2))
        sys.exit(0)

    args = sys.argv[1:]
    json_mode = '--json' in args
    args = [a for a in args if a != '--json']

    if len(args) < 2:
        print('Usage: sms-send <phone> <message> [--json]')
        print('       sms-send --show-config')
        sys.exit(1)

    to_num  = args[0]
    message = args[1]

    def fail(error, code):
        if json_mode:
            print(json.dumps({'status': 'error', 'to': to_num,
                              'error': error, 'error_code': code}))
        else:
            print(f'[sms] ERROR: {error}', file=sys.stderr)
        sys.exit(1)

    enc, parts, chars_per_part, total = sms_encoding(message)

    ok, code, error = send_sms(to_num, message, json_mode)

    if json_mode:
        if ok:
            print(json.dumps({
                'status':    'sent',
                'to':        to_num,
                'length':    total,
                'encoding':  enc,
                'parts':     parts,
                'in_thread': True,   # SMS always appears in Messages app
            }))
        else:
            print(json.dumps({
                'status':     'error',
                'to':         to_num,
                'error':      error,
                'error_code': code,
            }))
            sys.exit(1)
    else:
        if ok:
            print(f'[sms] Sent successfully.')
            if parts > 1:
                print(f'[sms] Note: message split into {parts} parts ({enc}, {total} chars).')
            print(f'[sms] Note: this SMS appears in your Messages app thread.')
        else:
            print(f'[sms] ERROR: {error}', file=sys.stderr)
            sys.exit(1)

if __name__ == '__main__':
    main()
